# Шаблон конфигурации генератора расписания MISIS
# Скопируйте этот файл в .env и заполните значения

# Название группы точно как в файле Excel
GROUP_NAME=BBI-24-1
# Номер подгруппы: 1 или 2
SUBGROUP_NUMBER=1
# Название листа в файле Excel
SHEET_NAME=Sheet1

# Как получать файл расписания: file, url или auto
SCHEDULE_SOURCE=file
# Путь к локальному файлу расписания (используется при SCHEDULE_SOURCE=file)
SCHEDULE_FILE_PATH=./schedule.xls
# Прямая ссылка на файл расписания (используется при SCHEDULE_SOURCE=url)
SCHEDULE_FILE_URL=https://example.com/schedule.xls
# Страница, где искать ссылку на расписание (используется при SCHEDULE_SOURCE=auto)
SCHEDULE_PAGE_URL=https://misis.ru/students/schedule/
# CSS-селектор ссылки на странице расписания (используется при SCHEDULE_SOURCE=auto)
SCHEDULE_LINK_SELECTOR=.col-md-2:nth-child(2) .first_child a

# Даты начала (понедельник) первой верхней и нижней недель
UPPER_WEEK_START=2025-09-01
LOWER_WEEK_START=2025-09-08

# Имя создаваемого файла iCalendar
ICS_FILENAME=schedule.ics
