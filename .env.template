# MISIS schedule generator configuration template
# Copy this file to .env and adjust the values

# Name of the group exactly as in the Excel file
GROUP_NAME=BBI-24-1
# Name of the sheet within the Excel file
SHEET_NAME=Sheet1

# How to obtain the schedule file: file, url, or auto
SCHEDULE_SOURCE=file
# Path to the local schedule file (used when SCHEDULE_SOURCE=file)
SCHEDULE_FILE_PATH=./schedule.xls
# Direct URL to the schedule file (used when SCHEDULE_SOURCE=url)
SCHEDULE_FILE_URL=https://example.com/schedule.xls
# Page URL to search for the schedule link (used when SCHEDULE_SOURCE=auto)
SCHEDULE_PAGE_URL=https://misis.ru/students/schedule/
# CSS selector for the link on the schedule page (used when SCHEDULE_SOURCE=auto)
SCHEDULE_LINK_SELECTOR=.col-md-2:nth-child(2) .first_child a

# Start dates (Monday) for the first upper and lower weeks
UPPER_WEEK_START=2025-09-01
LOWER_WEEK_START=2025-09-08

# Name of the generated iCalendar file
ICS_FILENAME=schedule.ics
